# AI Provider mode
# auto    = free users get Ghost 1 (DeepSeek), paid users get Ghost 2 (Claude)
# ghost_1 = everyone gets DeepSeek
# ghost_2 = everyone gets Claude
AI_PROVIDER=auto

# Supabase — https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# Anthropic / Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY='your_anthropic_api_key'
ANTHROPIC_MODEL_FREE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PAID=claude-sonnet-4-6

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY='your_deepseek_api_key'
DEEPSEEK_MODEL_FREE=deepseek-v4-flash
DEEPSEEK_MODEL_PAID=deepseek-v4-pro

# OpenAI (optional, not used by default)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_FREE=gpt-4o-mini
OPENAI_MODEL_PAID=gpt-4o

# ZeroGPT — https://zerogpt.com/api
ZEROGPT_API_KEY=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PREMIUM=price_...

FRONTEND_URL=http://localhost:3000
LOCAL_DEV_MODE='false'
APP_STORAGE='postgres'
POSTGRES_HOST='localhost'
POSTGRES_PORT='5432'
POSTGRES_DB='humanizer'
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='your_database_password'
APP_LOGIN_EMAIL='you@example.com'
APP_LOGIN_PASSWORD='your_app_login_password'
SESSION_COOKIE_SECURE='false'

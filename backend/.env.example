# AI Provider mode
# auto    = free users get Ghost 1 (DeepSeek), paid users get Ghost 2 (Claude)
# ghost_1 = everyone gets DeepSeek
# ghost_2 = everyone gets Claude
AI_PROVIDER=auto

# Supabase — https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# Anthropic / Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL_FREE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PAID=claude-sonnet-4-6

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL_FREE=deepseek-v4-flash
DEEPSEEK_MODEL_PAID=deepseek-v4-pro

# OpenAI (optional, not used by default)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_FREE=gpt-4o-mini
OPENAI_MODEL_PAID=gpt-4o

# ZeroGPT — https://zerogpt.com/api
ZEROGPT_API_KEY=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PREMIUM=price_...

FRONTEND_URL=http://localhost:3000
